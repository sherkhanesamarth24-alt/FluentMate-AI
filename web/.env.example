# ==============================================================================
# FluentMate AI (Web) Environment Variables
# ==============================================================================
# IMPORTANT:
# 1. To reuse your existing Android Firebase project (gen-lang-client-0095552660),
#    first register a Web App inside Firebase Console -> Project Settings -> Your apps,
#    enable Google Sign-In, and add your local + Cloudflare Pages domain to
#    Authentication -> Settings -> Authorized domains.
# 2. Copy the verified Web SDK values below into .env (for local dev) and into
#    Cloudflare Pages -> Settings -> Environment variables (for production).
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0095552660
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Existing named Firestore database shared with the FluentMate AI Android app:
VITE_FIREBASE_DATABASE_ID=ai-studio-android-fluentma-03fa4c1b-c4f5-4780-aa9d-a90c5a9a3ecd

# ==============================================================================
# Server-side Secret ONLY (NEVER prefix with VITE_)
# Set GEMINI_API_KEY in Cloudflare Pages Secrets / Environment Variables
# (used exclusively by functions/api/gemini.ts on the server).
# ==============================================================================
GEMINI_API_KEY=
